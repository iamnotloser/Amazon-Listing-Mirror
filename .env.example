# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交
# 西柚 MCP（可选）：补近 30 天销量、用西柚校验 BSR
XIYOU_MCP_URL=https://mcp.xydc.com/mcp
XIYOU_MCP_TOKEN=

# 视觉模型（可选）：图片语义评分，未填写则只出规则分
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
VISION_API_KEY=
# 单次请求最多图片数（默认 5）
# VISION_MAX_IMAGES=5

# 标题 / 五点中文对照的翻译模型（复用上面的 Base URL 与 Key）
TEXT_MODEL=qwen-plus
